{
  "name": "spoken-text-repo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the spoken-text package and its demo.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter demo dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter spoken-text build && pnpm -r typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm --filter spoken-text build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1"
  }
}
